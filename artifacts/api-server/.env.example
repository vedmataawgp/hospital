# Copy this file to .env and fill in your secrets.
# Do not commit .env to version control!

# Required (Change these if testing in production)
DJANGO_SECRET_KEY=django-insecure-hospital-system-secret-key-change-in-production-2024
DJANGO_DEBUG=True

# Database (Optional - defaults to SQLite)
# DATABASE_URL=postgresql://user:password@localhost:5432/medicare

# Redis (Optional)
# REDIS_URL=redis://localhost:6379/1

# Email (Optional)
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL="MediCare Hospital <noreply@medicare.hospital>"
